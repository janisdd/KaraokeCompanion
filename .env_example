ULTRA_START_SONGS_DIR_PATH1=/path/to/songs
# Must match the real download directory on disk (under ALL_FILES_PREFIX_DIR when using relative DOWNLOAD_SONGS_DIR)
ULTRA_START_SONGS_DIR_PATH2=storage_dir/download_work
# Root for relative USERS_DIR, PLAYLIST_CACHE_DIR_PATH, REDOWNLOAD_SONGS_TRASH_DIR, DOWNLOAD_SONGS_DIR, and default online_songs_index.json
ALL_FILES_PREFIX_DIR=storage_dir
PLAYLIST_CACHE_DIR_PATH=playlistCaches
IS_DEFAULT_PAGE_THEME_MODE_DARK=false
ULTRASTAR_COMPANION_URL=http://localhost:3001
LOG_LEVEL=DBEUG
USERS_DIR=users
REDOWNLOAD_SONGS_TRASH_DIR=trash
DOWNLOAD_SONGS_DIR=download_work
REQUIRED_WAIT_TIME_FOR_SONG_DOWNLOAD=30
DOWNLOAD_PREFERRED_VIDEO_HEIGHT=720
DOWNLOAD_PREFERRED_VIDEO_FORMAT=mp4
DOWNLOAD_CONVERT_AUDIO_FORMAT=mp3
ALL_SONGS_BY_ARTIST_PAGE=https://usdb.animux.de/index.php?link=byartist
DOWNLOAD_USE_HEADLESS_MODE=true
MAX_DOWNLOAD_QUEUE_SIZE_FRONTEND=5
NUM_ANALYZE_WORKERS=2
ADMIN_PAGE_PW=12345
NORMAL_LOUDNESS=-16
ONLINE_SONGS_INDEX_NAME=online_songs_index.json
WAIT_TO_REPLACE_FILE_FOR_EXECUTE_HELPERS_IN_MS=200
REPLACE_FILE_FOR_EXECUTE_HELPERS_ATTEMPTS=5

